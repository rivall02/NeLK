# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"

# Supabase / PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""

# Multi-Model AI Providers
# 1. Google Gemini (Multimodal, Schedule OCR, RAG Summary)
GEMINI_API_KEY=""

# 2. Groq (Ultra Fast Inference - Llama 3.3 70B)
GROQ_API_KEY=""

# 3. Mimo AI (Deep Reasoning - DeepSeek V3 / Qwen)
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.mimoai.top/v1"

# Google OAuth & Classroom Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Strava Fitness Integration
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_VERIFY_TOKEN="nelk_strava_webhook_token"

# Stripe / Payment Gateway
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Local File Storage Configuration
STORAGE_DIR="storage/documents"
MAX_FILE_SIZE_BYTES=10485760

# Cron Job Security
# Generate with: openssl rand -hex 32
CRON_SECRET=""
