# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nelk_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nelk_db?schema=public"

# NextAuth / Session Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-32-char-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google AI (Gemini) API Key
# Required for AI summaries, study insights, and AI chatbot
GEMINI_API_KEY="your-gemini-api-key"

# Google OAuth & Classroom Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Strava Fitness Integration
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_VERIFY_TOKEN="your-custom-strava-webhook-verify-token"

# Stripe / Payment Gateway (Production Billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Storage Configuration (Local non-public storage directory)
STORAGE_DIR="storage/documents"
MAX_FILE_SIZE_BYTES=10485760
