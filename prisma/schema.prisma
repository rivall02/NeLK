generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  xp               Int             @default(0)
  level            Int             @default(1)
  role             String          @default("USER")
  subscriptionPlan String          @default("FREE")
  contextMode      String          @default("NORMAL")
  university       String?
  major            String?
  profileImageUrl  String?
  language         String          @default("id")
  timeFormat       String          @default("24h")
  timezone         String          @default("Asia/Jakarta")
  notificationSettings Json?
  privacyProfile   String          @default("private")
  activeSessionId  String?         // Currently active study session
  accounts         Account[]
  sessions         Session[]
  tasks            Task[]
  notes            Note[]
  events           Event[]
  collections      Collection[]
  documents        Document[]
  courses          Course[]
  flashcards       Flashcard[]
  posts            CommunityPost[]
  activities       Activity[]
  notifications    Notification[]
  dailyQuizAttempts UserQuizAttempt[]
  studySessions    StudySession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// NeLK Models

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  subject     String?
  dueDate     DateTime?
  sourceUrl   String?
  userId      String
  sessionId   String?
  courseId    String?
  session     StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Note {
  id           String      @id @default(cuid())
  title        String
  content      String?
  visibility   String      @default("private") // "public" | "private"
  userId       String
  sessionId    String?
  courseId     String?
  collectionId String?
  session      StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  userId      String
  sessionId   String?
  courseId    String?
  session     StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id        String     @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id           String      @id @default(cuid())
  title        String
  content      String?
  fileUrl      String?
  fileSize     Int?
  mimeType     String?
  storageKey   String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Course {
  id           String      @id @default(cuid())
  title        String
  description  String?
  userId       String
  sessionId    String?
  courseId     String?     // Google Classroom course ID (for sync)
  session      StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards   Flashcard[]
  tasks        Task[]
  notes        Note[]
  events       Event[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  type      String   @default("system")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id       String @id @default(cuid())
  front    String
  back     String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("Diskusi Umum")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  type      String
  duration  Int?
  calories  Int?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyQuiz {
  id            String   @id @default(cuid())
  question      String
  topic         String
  correctAnswer String
  options       Json?
  date          DateTime @default(now())
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  userAttempts  UserQuizAttempt[]
}

model UserQuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  dailyQuizId  String
  dailyQuiz    DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answeredAt   DateTime @default(now())
  isCorrect    Boolean
  timeTaken    Int?
}

// Study Session for separating data per semester/period
model StudySession {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  isAllTime   Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notes       Note[]
  events      Event[]
  courses     Course[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}