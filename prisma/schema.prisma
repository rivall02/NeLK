generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password         String?
  xp               Int       @default(0)
  level            Int       @default(1)
  role             String    @default("USER")
  subscriptionPlan String    @default("FREE")
  contextMode      String    @default("NORMAL") // "NORMAL", "EXAM_WEEK", "VACATION"
  university       String?
  major            String?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  notes         Note[]
  events        Event[]
  collections   Collection[]
  documents     Document[]
  courses       Course[]
  flashcards    Flashcard[]
  posts         CommunityPost[]
  activities    Activity[]
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// NeLK Models

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO") // "TODO", "IN_PROGRESS", "DONE"
  priority    String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  subject     String?
  dueDate     DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id           String   @id @default(cuid())
  title        String
  content      String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// V1 Knowledge Models
model Collection {
  id          String   @id @default(cuid())
  name        String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  documents   Document[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  title        String
  content      String?
  fileUrl      String?
  fileSize     Int?
  mimeType     String?
  storageKey   String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// V2 Learning Models
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards  Flashcard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  type      String   @default("system") // e.g. 'reminder', 'system', 'gamification'
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id          String   @id @default(cuid())
  front       String
  back        String
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// V5 Community Models
model CommunityPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("Diskusi Umum")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// V6 Fitness Models
model Activity {
  id          String   @id @default(cuid())
  title       String
  type        String
  duration    Int?     // minutes
  calories    Int?     // kcal
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
